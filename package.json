{
  "name": "enchanted-wiki",
  "homepage": "https://www.slyckster.dev",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --config vite.config.ssg.js",
    "build": "npm run build:client && npm run build:server",
    "prerender": "vite-node scripts/prerender.js",
    "generate-assets": "node scripts/generate-assets.js",
    "generate-sitemap": "vite-node scripts/generate-sitemap.js",
    "generate:all": "npm run generate-assets && vite-node scripts/generate-sitemap.js",
    "build:static": "npm run build && npm run prerender && npm run generate:all",
    "lint": "eslint .",
    "preview": "vite preview",
    "serve": "serve dist/client",
    "predeploy": "npm run build:static && copy dist\\client\\index.html dist\\client\\404.html",
    "deploy": "del-cli .gh-pages && gh-pages --dotfiles -d dist/client"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@tailwindcss/vite": "^4.1.16",
    "bootstrap": "^5.3.8",
    "clsx": "^2.1.1",
    "gh-pages": "^6.3.0",
    "react": "^19.1.1",
    "react-bootstrap": "^2.10.10",
    "react-countdown": "^2.3.6",
    "react-dom": "^19.1.1",
    "react-helmet-next": "^0.0.2",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@headlessui/tailwindcss": "^0.2.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "del-cli": "^7.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "serve": "^14.2.5",
    "vite": "^7.1.7",
    "vite-node": "^5.1.0"
  }
}
